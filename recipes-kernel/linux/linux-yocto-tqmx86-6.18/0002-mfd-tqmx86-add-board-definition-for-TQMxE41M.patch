From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nora Schiffer <nora.schiffer@ew.tq-group.com>
Date: Wed, 26 Nov 2025 13:18:00 +0100
Subject: [PATCH] mfd: tqmx86: add board definition for TQMxE41M

This adds support for the TQ-Systems TQMxE41M COM, a COM Express Mini
module based on Intel Atom x7000E/RE processors:

https://www.tq-group.com/en/products/tq-embedded/cpu-families/x86-architecture/tqmxe41m/

Signed-off-by: Nora Schiffer <nora.schiffer@ew.tq-group.com>
Upstream-Status: Pending
---
 drivers/mfd/tqmx86.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/mfd/tqmx86.c b/drivers/mfd/tqmx86.c
index 1c2fe3f912389c0f04da40c40549f9549fa97076..4aef72bb585dac8b3f84d0bec91c4e93ade542a9 100644
--- a/drivers/mfd/tqmx86.c
+++ b/drivers/mfd/tqmx86.c
@@ -42,6 +42,7 @@
 #define TQMX86_REG_BOARD_ID_E40C1	14
 #define TQMX86_REG_BOARD_ID_E40C2	15
 #define TQMX86_REG_BOARD_ID_130UC	16
+#define TQMX86_REG_BOARD_ID_E41M	18
 #define TQMX86_REG_BOARD_ID_E41S	19
 #define TQMX86_REG_BOARD_ID_CU1_HPCM	24
 #define TQMX86_REG_BOARD_ID_CU2_HPCM	25
@@ -165,6 +166,8 @@ static const char *tqmx86_board_id_to_name(u8 board_id, u8 sauc)
 		return "TQMxE40C2";
 	case TQMX86_REG_BOARD_ID_130UC:
 		return "TQMx130UC";
+	case TQMX86_REG_BOARD_ID_E41M:
+		return "TQMxE41M";
 	case TQMX86_REG_BOARD_ID_E41S:
 		return "TQMxE41S";
 	case TQMX86_REG_BOARD_ID_CU1_HPCM:
@@ -190,6 +193,7 @@ static int tqmx86_board_id_to_clk_rate(struct device *dev, u8 board_id)
 	case TQMX86_REG_BOARD_ID_E40C1:
 	case TQMX86_REG_BOARD_ID_E40C2:
 	case TQMX86_REG_BOARD_ID_130UC:
+	case TQMX86_REG_BOARD_ID_E41M:
 	case TQMX86_REG_BOARD_ID_E41S:
 	case TQMX86_REG_BOARD_ID_CU1_HPCM:
 	case TQMX86_REG_BOARD_ID_CU2_HPCM:
